+        internal static AttitudeVector BankedCoastPointing(AttitudeVector retrograde, AttitudeVector up,
+            AttitudeVector north, double bankDegrees, double pitchDegrees, out AttitudeVector forward)
+        {
+            AttitudeVector pitchUp = Rotate(PitchUp(retrograde, up, north), retrograde, bankDegrees * Degree);
+            double angle = pitchDegrees * Degree;
+            double sine = Math.Sin(angle), cosine = Math.Cos(angle);
+            forward = pitchUp * cosine - retrograde * sine;
+            return retrograde * cosine + pitchUp * sine;
+        }
+
         internal static double PitchAoa(AttitudeVector retrograde, AttitudeVector pointing, AttitudeVector up,
                                         AttitudeVector north)
         {
             return Math.Atan2(pointing.Dot(PitchUp(retrograde, up, north)), pointing.Dot(retrograde)) / Degree;
+        }
+
+        internal static double GlideYawAssist(double yawError, double yawRate)
+        {
+            // Release yaw around a settled pitch plane, including residual
+            // yaw velocity so the assist can brake a turn before releasing.
+            double demand = Math.Max(Math.Abs(yawError) / Degree, Math.Abs(yawRate) / (0.5 * Degree));
+            double blend = Math.Max(0, Math.Min(1, (demand - 1) / 3));
+            return blend * blend * (3 - 2 * blend);
+        }
+
+        internal static double RollPointingWeight(double pointingError, double zeroRollError = 20)
+        {
+            double fullRollError = Math.Min(5, zeroRollError / 2);
+            double blend = Math.Max(0, Math.Min(1, (pointingError / Degree - fullRollError) / (zeroRollError - fullRollError)));
+            return 1 - blend * blend * (3 - 2 * blend);
+        }
+
+        internal static double LimitRollForPointing(double pitch, double roll, double yaw)
+        {
+            // Budget roll from the normalized control left after pointing.
+            double remaining = Math.Max(0, 1 - Math.Sqrt(pitch * pitch + yaw * yaw));
+            return Clamp(roll, remaining);
         }
 
